        <mxCell id="radius" value="FreeRADIUS&#10;szerver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2e6;strokeColor=#1baf7a;fontColor=#1a1a19;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="335" width="180" height="55" as="geometry" />
