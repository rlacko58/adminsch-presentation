        <mxCell id="dhcpconf" value="isc-dhcp-server config&#10;(validálva, mielőtt élesbe kerül)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f4;strokeColor=#9b9b93;fontColor=#1a1a19;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="245" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bind" value="BIND9&#10;DNS szerver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2e6;strokeColor=#1baf7a;fontColor=#1a1a19;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="335" width="180" height="55" as="geometry" />
