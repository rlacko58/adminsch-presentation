        <mxCell id="dhcp" value="ISC DHCP&#10;szerver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2e6;strokeColor=#1baf7a;fontColor=#1a1a19;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="335" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="resilience" value="Ha az AdminSCH leáll: a DNS, RADIUS és DHCP szerverek tovább szolgálnak ki kéréseket az utoljára szinkronizált adatokkal — csak új változás nem jut át, amíg a rendszer vissza nem áll." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2e6;strokeColor=#1baf7a;fontColor=#1a1a19;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
